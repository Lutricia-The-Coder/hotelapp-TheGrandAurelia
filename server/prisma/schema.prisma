generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  city        String
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}